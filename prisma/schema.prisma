generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  key   String @id
  value String
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password     String
  sessionToken String?
  createdAt    DateTime @default(now())
}

model Registration {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  instagram   String?
  brand       String
  model       String
  year        String
  description String
  photos      String[] @default([])
  status      String   @default("pending")
  paymentStatus String @default("pending")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  infoEmailSentAt DateTime?
  arrived     Boolean  @default(false)
  arrivedAt   DateTime?
}
