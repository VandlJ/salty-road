generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Setting {
  key   String @id
  value String
}

model Admin {
  id        Int            @id @default(autoincrement())
  username  String         @unique
  password  String
  createdAt DateTime       @default(now())
  sessions  AdminSession[]
}

// One row per logged-in device/browser — replaces the old single
// Admin.sessionToken (which meant a second login silently kicked out the
// first). tokenHash is a SHA-256 of the cookie value, never the raw token
// itself, so a leaked DB dump alone can't be used to log in.
model AdminSession {
  id        String   @id @default(cuid())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([adminId])
}

// One instalment of the event ("Volume 1"). Everything that differs between
// years lives here rather than in code, so a new edition is a row plus its
// prose in messages/*.json — not a homepage rewrite.
//
// The date/venue fields feed both the page copy and the Event JSON-LD.
//
// galleryPhotos lives here (rather than in code) because the gallery has an
// admin UI and its images are Blob uploads. Sponsors and videos deliberately
// do NOT: sponsor logos are static files under public/sponsors, so adding one
// needs a deploy anyway, and their per-logo `scaleClass` is presentational
// tuning you can only judge by looking at the rendered page. Keeping the
// metadata in the database while the asset needs a commit would split one
// change across two places. Those live in src/content/editions.ts, keyed by
// slug. Recap stat labels stay in messages/*.json since they're translated.
model Edition {
  id               String   @id @default(cuid())
  slug             String   @unique // URL segment: "vol1", "vol2"
  number           Int      @unique // 1, 2 — display order and "N. ročník"
  name             String // "Volume 1"
  startDate        DateTime
  endDate          DateTime
  venueName        String // "Velké náměstí"
  venueLocality    String // "Prachatice"
  // "upcoming" (registration/teaser homepage) | "live" (event running now)
  // | "archived" (look-back page). Exactly one edition should be non-archived.
  status           String   @default("upcoming")
  registrationOpen Boolean  @default(false)
  registrationFee  Int      @default(29900) // halire
  galleryPhotos    Json     @default("[]") // [{ url, instagram }]
  registrations    Registration[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model Registration {
  id          String   @id @default(cuid())
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id])
  firstName   String
  lastName    String
  email       String
  instagram   String?
  brand       String
  model       String
  year        String
  description String
  photos      String[] @default([])
  status      String   @default("pending")
  paymentStatus String @default("pending")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  infoEmailSentAt DateTime?
  arrived     Boolean  @default(false)
  arrivedAt   DateTime?
  idempotencyKey String? @unique // client-generated, dedupes retried submits
  thankYouEmailSentAt DateTime? // post-event thank-you + coupon email

  @@index([editionId, status, order])
  @@index([editionId, status, arrived])
}

model MerchProduct {
  id             String   @id @default(cuid())
  slug           String   @unique
  category       String // "hoodie" | "tshirt" | "car-scent" | "cap"
  name           String
  description    String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  // sitemap.ts previously had to fall back to createdAt for lastModified
  // because there was no updatedAt on this model.
  updatedAt      DateTime @updatedAt
  // "shared": `photos` below is used for every variant (e.g. same hoodie
  // photographed once, sold in multiple sizes). "per_variant": each
  // MerchVariant's own `images` is used instead (e.g. a cap sold in two
  // different colors that need distinct photos).
  photoMode      String   @default("shared")
  photos         String[] @default([]) // Vercel Blob URLs, used when photoMode = "shared"
  sizeChartImage String? // shown as the last slide of the product gallery
  order          Int      @default(0) // admin-controlled shop display order
  // `active` is the master kill switch — false hides the product
  // everywhere (shop AND gift options), same meaning it always had.
  // `sellable`/`giftEligible` are independent on top of that, and the admin
  // UI presents them as one 3-way choice per product: classic product
  // (sellable, not gift), gift-only (not sellable, gift), or both.
  sellable       Boolean  @default(true)
  giftEligible   Boolean  @default(false)
  variants       MerchVariant[]

  // The public shop grid and the free-gift picker, which are the two
  // highest-traffic queries in the app.
  @@index([active, sellable, order])
  @@index([active, giftEligible, order])
}

model MerchVariant {
  id        String       @id @default(cuid())
  productId String
  product   MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String       @unique
  color     String? // e.g. "Černá"; null = product has no color dimension
  size      String? // e.g. "M", "XL", "2XL"; null = product has no size dimension. Sort order is
  // computed from a fixed size ladder (see SIZE_ORDER in src/lib/variantLabel.ts), not stored.
  price    Int // halire
  quantity Int      @default(0)
  images   String[] @default([]) // Vercel Blob URLs, used when product.photoMode = "per_variant"
  active   Boolean  @default(true)
  order    Int      @default(0) // admin-controlled color-group display order (shared across every
  // variant with the same color on this product), not alphabetical — sizes within a color always
  // sort automatically via the size ladder instead.

  @@index([productId])
}

model Order {
  id             String    @id @default(cuid())
  orderNumber    Int       @unique @default(autoincrement()) // used as the bank variable symbol (VS)
  createdAt      DateTime  @default(now())
  // Without this there is no record of *when* an order was marked paid or
  // shipped — createdAt was the only timestamp on the model.
  updatedAt      DateTime  @updatedAt
  customerName   String
  customerEmail  String
  customerPhone  String
  address        String? // null when deliveryMethod = "pickup"
  items          Json // snapshot: [{ sku, name, label, price, qty }]
  totalAmount    Int // halire, final amount after any discount, includes shippingFee
  paymentMethod  String // "bank_transfer" | "cod"
  deliveryMethod String    @default("shipping") // "shipping" | "pickup"
  shippingFee    Int       @default(0) // halire, snapshot at order time, 0 for pickup
  status         String    @default("pending") // "pending" | "paid" | "shipped" | "cancelled"
  // Two independent coupon slots — a discount coupon (percent/fixed) and a
  // free_shipping coupon can both be active on the same order at once.
  couponCode     String? // discount coupon code, if any
  discountAmount Int       @default(0) // halire, snapshot at order time
  shippingCouponCode String? // free_shipping coupon code, if any
  idempotencyKey String?   @unique // client-generated, dedupes retried checkout submits
  giftProductId  String? // free gift chosen at checkout, if any (see MerchProduct.giftEligible)
  giftVariantSku String?
  giftLabel      String? // snapshot of the gift product's name, for display without a join

  @@index([status])
  // The admin orders list is an unpaginated findMany ordered by createdAt
  // desc, and this is the one table that grows every season.
  @@index([createdAt])
}

// A customer asked to be notified when a currently out-of-stock variant is
// restocked. Deliberately NOT folded into Order (fake totalAmount/payment
// fields would pollute revenue reporting) — the admin orders page fetches
// and displays these alongside real orders instead.
model StockRequest {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  productSlug   String
  productName   String
  variantLabel  String
  sku           String
  customerName  String
  customerEmail String
  fulfilled     Boolean  @default(false)

  @@index([fulfilled])
  // The restock claim filters on both, inside a transaction.
  @@index([sku, fulfilled])
}

model ContactMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)

  @@index([read])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique // stored uppercase
  type       String // "percent" | "fixed" | "free_shipping"
  value      Int // percent 1-100, or halire for "fixed"; unused (0) for "free_shipping"
  maxUses    Int? // null = unlimited
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  expiresAt  DateTime?
  categories String[]  @default([]) // MerchProduct.category values this coupon applies to; empty = all categories
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}
