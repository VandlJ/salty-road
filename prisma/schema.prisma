generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Setting {
  key   String @id
  value String
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password     String
  sessionToken String?
  createdAt    DateTime @default(now())

  @@index([sessionToken])
}

model Registration {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  instagram   String?
  brand       String
  model       String
  year        String
  description String
  photos      String[] @default([])
  status      String   @default("pending")
  paymentStatus String @default("pending")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  infoEmailSentAt DateTime?
  arrived     Boolean  @default(false)
  arrivedAt   DateTime?

  @@index([status, order])
}

model MerchProduct {
  id             String   @id @default(cuid())
  slug           String   @unique
  category       String // "hoodie" | "tshirt" | "car-scent" | "cap"
  name           String
  description    String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  // "shared": `photos` below is used for every variant (e.g. same hoodie
  // photographed once, sold in multiple sizes). "per_variant": each
  // MerchVariant's own `images` is used instead (e.g. a cap sold in two
  // different colors that need distinct photos).
  photoMode      String   @default("shared")
  photos         String[] @default([]) // Vercel Blob URLs, used when photoMode = "shared"
  sizeChartImage String? // shown as the last slide of the product gallery
  variants       MerchVariant[]
}

model MerchVariant {
  id        String       @id @default(cuid())
  productId String
  product   MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String       @unique
  label     String // free text, e.g. "M / Black" or "Design: Shark"
  price     Int // halire
  quantity  Int          @default(0)
  images    String[]     @default([]) // Vercel Blob URLs, used when product.photoMode = "per_variant"
  active    Boolean      @default(true)
  order     Int          @default(0) // admin-controlled display order, not alphabetical

  @@index([productId])
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   Int      @unique @default(autoincrement()) // used as the bank variable symbol (VS)
  createdAt     DateTime @default(now())
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  items         Json // snapshot: [{ sku, name, label, price, qty }]
  totalAmount   Int // halire
  paymentMethod String // "bank_transfer" | "cod"
  status        String   @default("pending") // "pending" | "paid" | "shipped" | "cancelled"

  @@index([status])
}
