# Database
DATABASE_URL="postgresql://user:password@localhost:5432/saltyroad?schema=public"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="your_blob_token"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Salty Road <info@saltyroad.cz>"
ADMIN_EMAIL="admin@saltyroad.cz"
# Merch order notifications — separate inbox from event registrations above.
# Falls back to ADMIN_EMAIL if unset.
ORDER_EMAIL="shop@saltyroad.cz"

# App URL
NEXT_PUBLIC_URL="https://saltyroad.cz"

# Crew entry check-in (/entry page)
ENTRY_PIN="change_me"
ENTRY_SESSION_SECRET="long_random_string_used_to_sign_crew_sessions"

# Cron endpoint auth (/api/cron/cleanup)
CRON_SECRET="long_random_string"

# Payment QR code (SPD) — bank account IBAN for registration fee
BANK_ACCOUNT_IBAN="CZ0000000000000000000000"

# Mapy.cz Suggest API — free key from https://developer.mapy.cz/, used for
# the address autocomplete in shop checkout. Optional: without it, the
# autocomplete just shows no suggestions and checkout still works fine.
MAPY_CZ_API_KEY=""

# Optional: distributed rate limiting across serverless instances (Upstash Redis REST API).
# Without these, rate limits fall back to a per-instance in-memory counter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""