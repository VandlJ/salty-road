# Database
DATABASE_URL="postgresql://user:password@localhost:5432/saltyroad?schema=public"
# Direct (non-pooled, non-Accelerate) connection. Required: prisma/schema.prisma
# declares it as `directUrl`, and the Vercel build runs `prisma migrate deploy`
# through it — migrations cannot go through the Accelerate proxy that
# DATABASE_URL points at in production.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/saltyroad?schema=public"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="your_blob_token"

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Salty Road <info@saltyroad.cz>"
ADMIN_EMAIL="admin@saltyroad.cz"
# Merch order notifications — separate inbox from event registrations above.
# Falls back to ADMIN_EMAIL if unset.
ORDER_EMAIL="shop@saltyroad.cz"
# Sender address for shop emails (customer confirmation + the ORDER_EMAIL
# notification above) — separate from EMAIL_FROM, which is used for event
# registration emails. Falls back to EMAIL_FROM if unset.
SHOP_EMAIL_FROM="Salty Road Shop <shop@saltyroad.cz>"
# Sender for the post-event exhibitor thank-you blast — separate from
# EMAIL_FROM so it doesn't go out from the registration address. Falls back to
# the older VOL1_THANK_YOU_EMAIL_FROM, then to EMAIL_FROM.
THANK_YOU_EMAIL_FROM="Salty Road <info@saltyroad.cz>"

# App URL
NEXT_PUBLIC_URL="https://saltyroad.cz"

# Crew entry check-in (/entry page)
ENTRY_PIN="change_me"
ENTRY_SESSION_SECRET="long_random_string_used_to_sign_crew_sessions"

# Cron endpoint auth (/api/cron/cleanup)
CRON_SECRET="long_random_string"

# Payment QR code (SPD) — bank account IBAN for registration fee
BANK_ACCOUNT_IBAN="CZ0000000000000000000000"

# Mapy.cz Suggest API — free key from https://developer.mapy.cz/, used for
# the address autocomplete in shop checkout. Optional: without it, the
# autocomplete just shows no suggestions and checkout still works fine.
MAPY_CZ_API_KEY=""

# Optional: distributed rate limiting across serverless instances, backed by
# a self-hosted Redis (e.g. redis://user:password@your-vps-host:6379).
# Without this, rate limits fall back to a per-instance in-memory counter.
REDIS_URL=""

# Admin account seeding — `npm run seed:admin` creates/updates this user.
# ADMIN_USERNAME defaults to "admin"; ADMIN_PASSWORD is required.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me"

# Playwright e2e only — the admin the seeded test database logs in as
# (scripts/seedTestDb.mjs). Defaults are used when unset.
E2E_ADMIN_USERNAME="e2e-admin"
E2E_ADMIN_PASSWORD="e2e-test-password-12345"

# One-off scripts only: the address scripts/sendInfoEmail.mjs sends its
# single test message to.
TEST_EMAIL="you@example.com"
