    "@sentry/nextjs": "^10.70.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.2",
    "browser-image-compression": "^2.0.2",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.11.1",
    "motion": "^12.43.0",
    "next": "^16.1.1",
    "next-intl": "^4.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.7.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
